{
  "rules": {
    ".read": false,
    ".write": false,

    "bans": {
      ".read": false,
      ".write": false
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || !root.child('bans/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['nick', 'avatar', 'board', 'at'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,20}$/) && newData.parent().parent().parent().child('nicks/' + newData.val().toLowerCase()).val() === $uid"
        },
        "avatar": { ".validate": "newData.isString() && newData.val().matches(/^a[0-9]{2}$/)" },
        "tag": { ".validate": "newData.isString() && newData.val().matches(/^(jee|neet|upsc|boards|college|coding|work|reading|other)$/)" },
        "board": { ".validate": "newData.isBoolean()" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "nicks": {
      "$nick": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && !root.child('bans/' + auth.uid).exists()) || (!newData.exists() && (!data.exists() || data.val() === auth.uid)))",
        ".validate": "newData.isString() && $nick.matches(/^[a-z0-9_]{3,20}$/)"
      }
    },

    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["kind"],
      "$room": {
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : (newData.child('owner').val() === auth.uid && !root.child('bans/' + auth.uid).exists()))",
        ".validate": "newData.hasChildren(['name', 'kind', 'tag', 'focus', 'brk', 'quiet', 'strict', 'max', 'owner', 'slot', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && !newData.val().toLowerCase().contains('http') && !newData.val().toLowerCase().contains('www.') && !newData.val().contains('<')"
        },
        "kind": { ".validate": "newData.val() === 'custom'" },
        "tag": { ".validate": "newData.isString() && newData.val().matches(/^(jee|neet|upsc|boards|college|coding|work|reading|other)$/)" },
        "focus": { ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 90" },
        "brk": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
        "quiet": { ".validate": "newData.isBoolean()" },
        "strict": { ".validate": "newData.isBoolean()" },
        "max": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 100" },
        "owner": { ".validate": "newData.val() === auth.uid" },
        "slot": {
          ".validate": "newData.isString() && newData.val().matches(/^s[123]$/) && newData.parent().parent().parent().child('owned/' + auth.uid + '/' + newData.val()).val() === $room"
        },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "hidden": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : (newData.child('owner').val() === auth.uid && !root.child('bans/' + auth.uid).exists()))",
        ".validate": "newData.hasChildren(['name', 'kind', 'tag', 'focus', 'brk', 'quiet', 'strict', 'max', 'owner', 'slot', 'code', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && !newData.val().toLowerCase().contains('http') && !newData.val().toLowerCase().contains('www.') && !newData.val().contains('<')"
        },
        "kind": { ".validate": "newData.val() === 'custom'" },
        "tag": { ".validate": "newData.isString() && newData.val().matches(/^(jee|neet|upsc|boards|college|coding|work|reading|other)$/)" },
        "focus": { ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 90" },
        "brk": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
        "quiet": { ".validate": "newData.isBoolean()" },
        "strict": { ".validate": "newData.isBoolean()" },
        "max": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 100" },
        "owner": { ".validate": "newData.val() === auth.uid" },
        "slot": {
          ".validate": "newData.isString() && newData.val().matches(/^s[123]$/) && newData.parent().parent().parent().child('owned/' + auth.uid + '/' + newData.val()).val() === $room"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/) && newData.parent().parent().parent().child('codes/' + newData.val()).val() === $room"
        },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "owned": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slot": {
          ".write": "auth != null && auth.uid === $uid && (data.exists() ? (!newData.exists() && !newData.parent().parent().parent().child('rooms/' + data.val()).exists() && !newData.parent().parent().parent().child('hidden/' + data.val()).exists()) : !root.child('bans/' + auth.uid).exists())",
          ".validate": "$slot.matches(/^s[123]$/) && newData.isString()"
        }
      }
    },

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? (!newData.exists() && root.child('hidden/' + data.val() + '/owner').val() === auth.uid) : (newData.parent().parent().child('hidden/' + newData.val() + '/owner').val() === auth.uid && !root.child('bans/' + auth.uid).exists()))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.isString()"
      }
    },

    "online": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!root.child('bans/' + auth.uid).exists() && (root.child('rooms/' + $room).exists() || root.child('hidden/' + $room).exists())))) || (!newData.exists() && data.child('conn').val() === false && data.child('ends').val() < now - 600000 && data.child('since').val() < now - 600000))",
          ".validate": "newData.hasChildren(['nick', 'avatar', 'state', 'since', 'ends', 'away', 'conn'])",
          "nick": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/nick').val()" },
          "avatar": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/avatar').val()" },
          "tag": { ".validate": "newData.isString() && newData.val().matches(/^(jee|neet|upsc|boards|college|coding|work|reading|other)$/)" },
          "state": { ".validate": "newData.isString() && newData.val().matches(/^(focus|break|idle)$/)" },
          "since": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "ends": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 5460000" },
          "away": { ".validate": "newData.isBoolean()" },
          "conn": { ".validate": "newData.isBoolean()" },
          "today": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
          "$other": { ".validate": false }
        }
      }
    },

    "here": {
      ".read": "auth != null",
      "$room": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (!root.child('bans/' + auth.uid).exists() && (root.child('rooms/' + $room).exists() || root.child('hidden/' + $room).exists())))",
          ".validate": "newData.val() === true"
        }
      }
    },

    "feed": {
      "$room": {
        ".read": "auth != null",
        ".indexOn": ["at"],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && !root.child('bans/' + auth.uid).exists() && (root.child('rooms/' + $room).exists() || root.child('hidden/' + $room).exists())) || (!newData.exists() && (!data.exists() || data.child('uid').val() === auth.uid || data.child('at').val() < now - 172800000)))",
          ".validate": "newData.hasChildren(['uid', 'nick', 'avatar', 'min', 'at'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "nick": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/nick').val()" },
          "avatar": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/avatar').val()" },
          "min": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 90" },
          "at": { ".validate": "newData.val() === now" },
          "fives": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (!root.child('bans/' + auth.uid).exists() && data.parent().parent().exists()))",
              ".validate": "newData.val() === true"
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "board": {
      "$room": {
        "$period": {
          ".read": "auth != null",
          ".indexOn": ["min"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (!root.child('bans/' + auth.uid).exists() && root.child('profiles/' + auth.uid + '/board').val() === true && (root.child('rooms/' + $room).exists() || root.child('hidden/' + $room).exists())))",
            ".validate": "$period.matches(/^(d[0-9]{8}|w[0-9]{6})$/) && newData.hasChildren(['nick', 'avatar', 'min', 'at'])",
            "nick": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/nick').val()" },
            "avatar": { ".validate": "newData.val() === root.child('profiles/' + auth.uid + '/avatar').val()" },
            "min": {
              ".validate": "newData.isNumber() && newData.val() <= 10080 && newData.val() - (data.exists() ? data.val() : 0) >= 1 && newData.val() - (data.exists() ? data.val() : 0) <= 90 && newData.val() - (data.exists() ? data.val() : 0) <= (now - (data.parent().child('at').exists() ? data.parent().child('at').val() : 0)) / 60000 + 1"
            },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['by', 'room', 'why', 'at'])",
        "by": { ".validate": "newData.val() === auth.uid" },
        "room": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "why": { ".validate": "newData.isString() && newData.val().matches(/^(name|nick|spam|other)$/)" },
        "at": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
