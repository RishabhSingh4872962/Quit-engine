# Copy to .env and fill in. EXPO_PUBLIC_ values are bundled into the app, so only put public keys here.

# RevenueCat public SDK key for Android (RevenueCat > Project settings > API keys, starts with "goog_").
# Without it, debug builds run Premium in test mode with fake plans; release builds hide Premium.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Call-token Worker for invite-only room calls (workers/call-token), e.g. https://quit-engine-calls.<you>.workers.dev
# Without it, rooms have no call button.
EXPO_PUBLIC_CALLS_URL=

# Buddy push Worker (workers/buddy-push), e.g. https://quit-engine-push.<you>.workers.dev
# Without it, buddies see requests and answers only when they open the app (no notifications).
EXPO_PUBLIC_PUSH_URL=
